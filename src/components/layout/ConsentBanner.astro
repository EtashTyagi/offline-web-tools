---
// Anonymous usage-data consent banner. Only rendered when telemetry is
// available (GA_MEASUREMENT_ID set). All UI is plain HTML + inline JS so it
// adds zero hydration cost.
---

<div
  id="owt-consent"
  class="fixed inset-x-0 bottom-0 z-50 hidden translate-y-full opacity-0 transition duration-300 sm:inset-x-4 sm:bottom-4 sm:left-auto sm:right-4 sm:max-w-md"
  role="dialog"
  aria-modal="false"
  aria-labelledby="owt-consent-title"
  data-owt-consent
>
  <div class="rounded-xl bg-white p-5 shadow-lg ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700">
    <h2 id="owt-consent-title" class="text-base font-semibold text-slate-900 dark:text-white">
      Help improve these tools
    </h2>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
      We collect <strong>anonymous</strong> usage counts (page views and which tools you open or use)
      to see what is popular and improve the site. No accounts, no per-user tracking, no personal data.
      You can change this anytime from the settings icon.
    </p>
    <div class="mt-4 flex items-center justify-end gap-3">
      <button
        type="button"
        id="owt-consent-decline"
        class="btn-secondary px-4 py-2 text-sm"
      >
        No thanks
      </button>
      <button
        type="button"
        id="owt-consent-accept"
        class="btn-primary px-4 py-2 text-sm"
      >
        Allow
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const KEY = 'owt_consent';
    const banner = document.getElementById('owt-consent');
    if (!banner) return;

    let existing = null;
    try { existing = localStorage.getItem(KEY); } catch (e) {}
    // Only show on a first visit (no decision yet).
    if (existing === 'accepted' || existing === 'declined') return;

    function close(value) {
      if (window.owtTelemetry && typeof window.owtTelemetry.setConsent === 'function') {
        window.owtTelemetry.setConsent(value);
      } else {
        try { localStorage.setItem(KEY, value); } catch (e) {}
      }
      banner.classList.add('translate-y-full', 'opacity-0');
      setTimeout(() => banner.classList.add('hidden'), 300);
    }

    const accept = document.getElementById('owt-consent-accept');
    const decline = document.getElementById('owt-consent-decline');
    if (accept) accept.addEventListener('click', () => close('accepted'));
    if (decline) decline.addEventListener('click', () => close('declined'));

    // Reveal after a short delay so it does not fight the hero animation.
    setTimeout(() => {
      banner.classList.remove('hidden');
      requestAnimationFrame(() => {
        banner.classList.remove('translate-y-full', 'opacity-0');
      });
    }, 1500);
  })();
</script>
