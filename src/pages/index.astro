---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ui/ToolCard.astro';
import { allTools, nonEmptyCategories } from '../lib/registry';
import { buildMetaTags, websiteJsonLd } from '../lib/seo';
import { isOpenSource, GITHUB_REPO_URL } from '../lib/ads';
import { hasUsageData, topTools, usageTotals, usageGeneratedAt } from '../lib/usage';

const openSource = isOpenSource();
const showUsage = hasUsageData();
const top = showUsage ? topTools(6) : [];
const totals = usageTotals();
const generatedAt = usageGeneratedAt();

const meta = buildMetaTags({
  title: 'OfflineWebTools — Private Tools That Run in Your Browser',
  description:
    'A growing collection of free web tools that run entirely in your browser. Financial calculators, file converters, image tools, and more. No uploads, no servers, no tracking.',
  keywords: ['web tools', 'online tools', 'offline tools', 'free tools', 'browser tools', 'private tools'],
  path: '/',
  ogType: 'website',
});
const jsonLd = websiteJsonLd();

const toolCount = allTools.length;
const catCount = nonEmptyCategories.length;

function pickRandom(arr: typeof allTools, n: number) {
  const pool = [...arr];
  const out = [];
  while (out.length < n && pool.length) {
    const i = Math.floor(Math.random() * pool.length);
    out.push(pool.splice(i, 1)[0]);
  }
  return out;
}

const showcase = pickRandom(allTools, Math.min(6, allTools.length));
const showcaseData = allTools.map((t) => ({
  id: t.id,
  name: t.name,
  icon: t.icon,
  shortDescription: t.shortDescription,
  category: t.category,
  path: `/tools/${t.category}/${t.id}`,
}));

const features = [
  {
    icon: '🔒',
    title: 'Private by design',
    body: 'Nothing is uploaded. Every calculation and conversion happens locally on your device.',
  },
  {
    icon: '⚡',
    title: 'Instantly fast',
    body: 'Tools load only when you open them. No heavy bundles, no waiting, no clutter.',
  },
  {
    icon: '🌙',
    title: 'Works offline',
    body: 'Once loaded, tools keep working without a connection. Bookmark them and use anywhere.',
  },
  ...(openSource
    ? [
        {
          icon: '🔓',
          title: 'Open source',
          body: 'Self-host the whole thing ad-free, or grab any single tool from the GitHub repo.',
        },
      ]
    : []),
];
---

<BaseLayout meta={meta}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} slot="head" />
  <script is:inline set:html={JSON.stringify(showcaseData)} type="application/json" id="showcase-data" />

  <!-- Hero -->
  <section class="relative overflow-hidden px-4 pb-24 pt-20 sm:pt-28">
    <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="animate-blob absolute -left-20 top-0 h-72 w-72 rounded-full bg-brand-500/20 blur-3xl dark:bg-brand-500/15"></div>
      <div class="animate-blob absolute right-0 top-10 h-80 w-80 rounded-full bg-purple-400/20 blur-3xl dark:bg-purple-500/15" style="animation-delay: -6s"></div>
      <div class="animate-blob absolute bottom-0 left-1/3 h-72 w-72 rounded-full bg-pink-400/20 blur-3xl dark:bg-pink-500/15" style="animation-delay: -12s"></div>
    </div>

    <div class="mx-auto max-w-4xl text-center">
      <p class="animate-float-up mb-5 inline-flex items-center gap-2 rounded-full bg-brand-100 px-4 py-1.5 text-sm font-medium text-brand-800 ring-1 ring-brand-300 dark:bg-slate-800 dark:text-brand-300 dark:ring-slate-600">
        <span aria-hidden="true">✨</span>
        {toolCount} tools, all client-side
      </p>
      <h1 class="animate-float-up text-5xl font-bold tracking-tight text-slate-900 sm:text-7xl dark:text-white" style="animation-delay: 0.1s">
        Tools that respect
        <span class="text-gradient">your privacy</span>
      </h1>
      <p class="animate-float-up mx-auto mt-6 max-w-2xl text-lg text-slate-600 sm:text-xl dark:text-slate-300" style="animation-delay: 0.2s">
        A collection of web tools that run entirely in your browser. No uploads, no
        servers, no tracking. Just open and use.
      </p>
      <div class="animate-float-up mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row" style="animation-delay: 0.3s">
        <a href="/search-tools" class="btn-primary px-6 py-3 text-base">
          Browse all tools
          <span aria-hidden="true">→</span>
        </a>
        {openSource && (
          <a
            href={GITHUB_REPO_URL}
            rel="noopener noreferrer"
            target="_blank"
            class="btn-secondary px-6 py-3 text-base"
          >
            View on GitHub
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="reveal mx-auto mb-24 max-w-5xl px-4">
    <dl class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div class="rounded-2xl bg-white p-6 text-center ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700">
        <dt class="sr-only">Total tools</dt>
        <dd class="text-4xl font-bold text-gradient">{toolCount}</dd>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Tools</p>
      </div>
      <div class="rounded-2xl bg-white p-6 text-center ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700">
        <dt class="sr-only">Categories</dt>
        <dd class="text-4xl font-bold text-gradient">{catCount}</dd>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Categories</p>
      </div>
      <div class="rounded-2xl bg-white p-6 text-center ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700">
        <dt class="sr-only">Data uploaded</dt>
        <dd class="text-4xl font-bold text-gradient">0</dd>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Bytes uploaded</p>
      </div>
      <div class="rounded-2xl bg-white p-6 text-center ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700">
        <dt class="sr-only">Cost</dt>
        <dd class="text-4xl font-bold text-gradient">Free</dd>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Forever</p>
      </div>
      {showUsage && (
        <div class="rounded-2xl bg-white p-6 text-center ring-1 ring-slate-200 dark:bg-slate-800 dark:ring-slate-700">
          <dt class="sr-only">Total tool uses</dt>
          <dd class="text-4xl font-bold text-gradient">{(totals.totalUses + totals.totalOpens).toLocaleString()}</dd>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Uses counted</p>
        </div>
      )}
    </dl>
  </section>

  <!-- Most used tools leaderboard -->
  {showUsage && (
    <section class="mx-auto mb-24 max-w-6xl px-4">
      <div class="reveal mb-8 text-center">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
          Most used tools
        </h2>
        <p class="mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-300">
          What the community reaches for most. Based on anonymous usage counts.
        </p>
      </div>
      <ol class="reveal grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {top.map((tool, i) => {
          const score = tool.uses * 5 + tool.opens;
          const maxScore = Math.max(...top.map((t) => t.uses * 5 + t.opens), 1);
          const pct = Math.round((score / maxScore) * 100);
          return (
            <li>
              <a
                href={tool.path}
                class="card group flex items-center gap-3 hover:ring-brand-500 dark:hover:ring-brand-400"
                aria-label={`${i + 1}. ${tool.name}`}
              >
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-100 text-sm font-bold text-brand-700 dark:bg-brand-900/40 dark:text-brand-300">
                  {i + 1}
                </span>
                <span class="text-2xl" aria-hidden="true">{tool.icon}</span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate font-semibold text-slate-900 group-hover:text-brand-600 dark:text-white dark:group-hover:text-brand-400">{tool.name}</span>
                  <span class="mt-1 block h-1.5 w-full overflow-hidden rounded-full bg-slate-100 dark:bg-slate-700">
                    <span class="block h-full rounded-full bg-gradient-to-r from-brand-500 to-purple-500" style={`width:${pct}%`}></span>
                  </span>
                </span>
              </a>
            </li>
          );
        })}
      </ol>
      {generatedAt && (
        <p class="reveal mt-6 text-center text-xs text-slate-400 dark:text-slate-500">
          Usage data refreshed {new Date(generatedAt).toLocaleDateString()}. Anonymous and aggregate only.
        </p>
      )}
    </section>
  )}

  <!-- Features -->
  <section class="mx-auto mb-24 max-w-6xl px-4">
    <div class="reveal mb-12 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        Built different
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-300">
        Most online tools send your data to a server. These don't.
      </p>
    </div>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {features.map((f, i) => (
        <div class={`reveal reveal-delay-${i + 1} rounded-2xl bg-white p-6 ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-lg dark:bg-slate-800 dark:ring-slate-700`}>
          <span class="text-3xl" aria-hidden="true">{f.icon}</span>
          <h3 class="mt-4 text-lg font-semibold text-slate-900 dark:text-white">{f.title}</h3>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{f.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Random tools showcase -->
  <section class="mx-auto mb-24 max-w-6xl px-4">
    <div class="reveal mb-8 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
          Try a tool
        </h2>
        <p class="mt-3 text-slate-600 dark:text-slate-300">
          A random pick from the collection. Shuffle for more.
        </p>
      </div>
      <button
        type="button"
        id="shuffle-btn"
        class="btn-secondary px-5 py-2.5"
        aria-label="Show different random tools"
      >
        <span aria-hidden="true">🎲</span> Shuffle
      </button>
    </div>
    <div id="showcase-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {showcase.map((tool) => (
        <ToolCard tool={tool} />
      ))}
    </div>
    <p class="reveal mt-8 text-center">
      <a href="/search-tools" class="text-brand-600 hover:underline dark:text-brand-400">
        See all {toolCount} tools →
      </a>
    </p>
  </section>

  <!-- Categories overview -->
  <section class="mx-auto mb-24 max-w-6xl px-4">
    <div class="reveal mb-8 text-center">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        Explore by category
      </h2>
    </div>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {nonEmptyCategories.map((cat) => (
        <a
          href={`/search-tools#${cat.slug}`}
          class="reveal group flex items-center gap-3 rounded-2xl bg-white p-5 ring-1 ring-slate-200 transition hover:-translate-y-1 hover:ring-brand-500 dark:bg-slate-800 dark:ring-slate-700 dark:hover:ring-brand-400"
        >
          <span class="text-2xl" aria-hidden="true">{cat.icon}</span>
          <span>
            <span class="block font-semibold text-slate-900 group-hover:text-brand-600 dark:text-white dark:group-hover:text-brand-400">{cat.name}</span>
            <span class="block text-xs text-slate-500 dark:text-slate-400">{cat.description}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Final CTA -->
  <section class="reveal mx-auto mb-16 max-w-4xl px-4">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-brand-600 via-purple-600 to-pink-600 p-12 text-center text-white">
      <div class="pointer-events-none absolute inset-0 -z-0 opacity-30" aria-hidden="true">
        <div class="animate-blob absolute -left-10 top-0 h-48 w-48 rounded-full bg-white/30 blur-3xl"></div>
        <div class="animate-blob absolute right-0 bottom-0 h-56 w-56 rounded-full bg-white/20 blur-3xl" style="animation-delay: -8s"></div>
      </div>
      <div class="relative">
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Ready to dive in?</h2>
        <p class="mx-auto mt-3 max-w-md text-white/90">
          No sign-up, no install, no data leaving your device. Just tools that work.
        </p>
        <a href="/search-tools" class="mt-8 inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-base font-semibold text-brand-700 transition hover:bg-slate-100">
          Browse all tools <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const dataEl = document.getElementById('showcase-data');
    const grid = document.getElementById('showcase-grid');
    const btn = document.getElementById('shuffle-btn');
    if (!dataEl || !grid || !btn) return;

    let tools = [];
    try { tools = JSON.parse(dataEl.textContent || '[]'); } catch (e) { return; }
    if (!tools.length) return;

    function pick(n) {
      const pool = [...tools];
      const out = [];
      while (out.length < n && pool.length) {
        out.push(pool.splice(Math.floor(Math.random() * pool.length), 1)[0]);
      }
      return out;
    }

    btn.addEventListener('click', () => {
      const picks = pick(Math.min(6, tools.length));
      grid.style.opacity = '0';
      grid.style.transition = 'opacity 0.2s ease';
      setTimeout(() => {
        grid.innerHTML = picks.map((t) => `
          <a href="${t.path}" class="card group flex flex-col gap-2 hover:ring-brand-500 dark:hover:ring-brand-400" aria-label="${t.name} tool">
            <div class="flex items-center justify-between">
              <span class="text-2xl" aria-hidden="true">${t.icon}</span>
            </div>
            <h3 class="text-base font-semibold text-slate-900 group-hover:text-brand-600 dark:text-white dark:group-hover:text-brand-400">${t.name}</h3>
            <p class="text-sm text-slate-600 dark:text-slate-300">${t.shortDescription}</p>
          </a>
        `).join('');
        grid.style.opacity = '1';
      }, 200);
    });
  })();

  (() => {
    const reveals = document.querySelectorAll('.reveal');
    if (!reveals.length) return;
    if (!('IntersectionObserver' in window)) {
      reveals.forEach((el) => el.classList.add('is-visible'));
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
    );
    reveals.forEach((el) => io.observe(el));
  })();
</script>
