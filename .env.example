# Copy this file to `.env` and fill in values as needed.
# By default (IS_OPEN_SOURCE unset/false) the build ships with NO GitHub
# links, NO ads, and NO "open source" copy. This is the private / closed
# deployment mode.

# Master toggle. Set to "true" to enable GitHub links, ad slots, and
# open-source marketing copy. Anything else (or unset) keeps all of that off.
# Default: false
IS_OPEN_SOURCE=

# Google AdSense client id. Only used when IS_OPEN_SOURCE=true. When set,
# ads render on the site. When empty/unset, no ad code is shipped.
# Example: ca-pub-1234567890123456
ADSENSE_CLIENT_ID=

# Canonical base URL for SEO, sitemap, and Open Graph tags.
SITE_URL=https://offline-web-tools.com

# Base URL of the GitHub repo. Only used when IS_OPEN_SOURCE=true. Used by
# the "get without ads" buttons and the source links.
GITHUB_REPO_URL=https://github.com/your-org/OfflineWebTools

# ---- Telemetry (anonymous, opt-in usage analytics) ----
# Google Analytics 4 measurement id, e.g. "G-XXXXXXXXXX".
# Telemetry is INDEPENDENT of IS_OPEN_SOURCE: set this on any build (open-source
# or private) where you want anonymous usage tracking.
# When empty/unset -> no telemetry at all: no GA script, no consent banner, no
# settings menu, zero tracking code shipped.
# When set -> users see a one-time consent popup on first visit. Nothing is sent
# to Google until the user opts in. They can change their choice anytime from the
# settings (gear) icon. All data is anonymous and aggregate (no per-user ids).
GA_MEASUREMENT_ID=

# ---- Build-time usage ingestion (optional, for the leaderboard) ----
# These are ONLY needed if you run `npm run fetch-usage` to bake a "Most used
# tools" leaderboard + total-usage stats into the static build. They are not
# required at runtime. They are read by scripts/fetch-usage.mjs.
# GA property id of the form "properties/123456789".
GA4_PROPERTY_ID=
# Path to a GA4 service-account JSON key authorized for the Data API.
GA4_CREDENTIALS_PATH=
